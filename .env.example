# Required — your OpenAI API key.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Optional — path to the style guide markdown file. Defaults to the bundled proofread/style_guide.md.
# STYLE_GUIDE_PATH=./proofread/style_guide.md

# Optional — number of paragraphs to proofread concurrently. Defaults to 8.
MAX_CONCURRENCY=8